];
const SENIORITY = ["Practitioner/Specialist","Manager/Lead","Director/Head","Executive/C-Level","Business Partner/Advisor"];
const SIZES = ["201-500","501-1,000","1,001-5,000","5,001-10,000","10,001+"];

/* ---------- build pickers ---------- */
function buildTree(el, DATA){
  DATA.forEach((ind,i)=>{
    const p = document.createElement('div'); p.className='par';
    const hd = document.createElement('div'); hd.className='parhd';
    const tw = ind.subs ? '<span class="tw">&#9654;</span>' : '<span class="tw"></span>';
    const badge = ind.subs ? `<span class="cnt">0/${ind.subs.length}</span>` : '';
    hd.innerHTML = `${tw}<input type="checkbox" data-par="${i}">
      <span class="nm">${ind.n}</span>${badge}`;
    p.appendChild(hd);
    if(ind.subs){
      const k = document.createElement('div'); k.className='kids hide';
      ind.subs.forEach((s,j)=>{
        const l=document.createElement('label'); l.className='chk';
        l.innerHTML=`<input type="checkbox" data-p="${i}" data-s="${j}"><span>${s}</span>`;
        k.appendChild(l);
      });
      p.appendChild(k);
      hd.addEventListener('click',e=>{
        if(e.target.tagName==='INPUT') return;
        hd.classList.toggle('open'); k.classList.toggle('hide');
      });
    }
    el.appendChild(p);
  });
  el.addEventListener('change',e=>{
    const t=e.target;
    if(t.dataset.par!==undefined){
      const i=+t.dataset.par;
      el.querySelectorAll(`input[data-p="${i}"]`).forEach(c=>c.checked=t.checked);
    } else if(t.dataset.p!==undefined){
      const i=+t.dataset.p;
      const kids=[...el.querySelectorAll(`input[data-p="${i}"]`)];
      const par=el.querySelector(`input[data-par="${i}"]`);
      const on=kids.filter(c=>c.checked).length;
      par.checked = on===kids.length; par.indeterminate = on>0 && on<kids.length;
    }
    render();
  });
}
function selectedFrom(el, DATA){
  const out=[];
  DATA.forEach((ind,i)=>{
    if(!ind.subs){ if(el.querySelector(`input[data-par="${i}"]`).checked) out.push({p:ind.n,s:[],n:1}); return; }
    const on=ind.subs.filter((_,j)=>el.querySelector(`input[data-p="${i}"][data-s="${j}"]`).checked);
    if(on.length) out.push({p:ind.n,s:on.length===ind.subs.length?['(all)']:on,n:on.length});
  });
  return out;
}
function paintCounts(el, DATA){
  DATA.forEach((ind,i)=>{
    if(!ind.subs) return;
    const on=[...el.querySelectorAll(`input[data-p="${i}"]`)].filter(c=>c.checked).length;
    const c=el.querySelectorAll('.par')[i].querySelector('.cnt');
    if(c) c.textContent=`${on}/${ind.subs.length}`;
  });
}
const tree = document.getElementById('tree');
const ftree = document.getElementById('ftree');
buildTree(tree, INDUSTRIES);
buildTree(ftree, FUNCTIONS);
const seng=document.getElementById('senGrid');
SENIORITY.forEach(s=>{
  const l=document.createElement('label'); l.className='chk';
  l.innerHTML=`<input type="checkbox" class="sen" value="${s}"><span>${s}</span>`;
  seng.appendChild(l);
});
seng.addEventListener('change',render);
const sg=document.getElementById('sizeGrid');
SIZES.forEach(s=>{
  const l=document.createElement('label'); l.className='chk';
  l.innerHTML=`<input type="checkbox" class="sz" value="${s}"><span>${s}</span>`;
  sg.appendChild(l);
});
sg.addEventListener('change',render);

/* ---------- helpers ---------- */
const $=id=>document.getElementById(id);
const v=id=>($(id)?.value||'').trim();
const ck=id=>!!$(id)?.checked;
const selectedIndustries = ()=>selectedFrom(tree, INDUSTRIES);
const selectedFunctions  = ()=>selectedFrom(ftree, FUNCTIONS);
const fmt = a => a.map(x=>x.s.length? x.p+': '+x.s.join(', ') : x.p).join(' | ');
function sizes(){return [...document.querySelectorAll('.sz')].filter(c=>c.checked).map(c=>c.value);}
function seniorities(){return [...document.querySelectorAll('.sen')].filter(c=>c.checked).map(c=>c.value);}
function weeksBetween(a,b){
  if(!a||!b) return 0;
  return Math.max(0,Math.round((new Date(b)-new Date(a))/6048e5));
}

/* ---------- conditional render + gaps ---------- */
function render(){
  const tt=v('tgtType'), pm=v('personaMode');
  const isTAL = tt==='Targeted Account List (TAL)' || tt==='TAL + Whitespace';
  const isWS  = tt==='Whitespace Only' || tt==='TAL + Whitespace';
  const isBoth= tt==='TAL + Whitespace';
  $('talBlock').classList.toggle('hide',!isTAL);
  $('wsBlock').classList.toggle('hide',!isWS);
  $('splitReq').style.display = isBoth?'inline':'none';
  const isEx = pm==='Example title list OR general description of audience groups';
  const isFS = pm==='Function + Seniority';
  const otherModes = pm && !isEx && !isFS;
  $('pExample').classList.toggle('hide', !isEx);
  $('pFunc').classList.toggle('hide', !isFS);
  $('pOther').classList.toggle('hide', !otherModes);
  if(otherModes){
    $('pOtherHint').textContent = pm==='Prebuilt Boolean'
      ? 'Paste the Boolean string exactly as supplied.'
      : 'Exact titles only, no interpretation.';
  }
  paintCounts(tree, INDUSTRIES);
  paintCounts(ftree, FUNCTIONS);

  /* gaps */
  const G=[];
  const need=(cond,gate,name,why)=>{ if(cond) G.push({gate,name,why}); };

  need(!v('progName'),'G1','Program name','Naming convention: Client FYxxQx – Theme – Tactics');
  need(!v('job'),'G1','Parent Job','Program cannot exist without it');
  need(!v('vendor'),'G1','Vendor','End client name');
  need(!v('owner'),'G1','Salesperson','Record owner');
  need(!v('csm'),'G1','Customer Success Manager','Named person');
  need(!tt,'G1','Campaign targeting type','Drives every other requirement — data team cannot start without it');
  need(!v('geo'),'G1','Target geographies','Count cannot be scoped');
  need(!v('countDue'),'G1','Count due date','No deadline set with the data team');
  need(selectedIndustries().length===0,'G1','Industry selection','Data team has no vertical filter');
  need(sizes().length===0,'G1','Employee size range','Data team has no firmographic filter');
  need(!pm,'G1','Type of title targeting','Persona mode drives what the data team builds');
  if(pm==='Example title list OR general description of audience groups'){
    need(!v('seniority'),'G1','Seniority floor','Manager+ vs Director+ changes reachable volume materially');
    need(!v('titles'),'G1','Example titles','No basis to build the Boolean');
    need(!v('falsePos'),'G1','False-positive exclusions','Without these the count returns the wrong people — this is where lead quality lives');
  } else if(isFS){
    need(selectedFunctions().length===0,'G1','Function selection','No functions ticked — data team has no persona filter');
    need(seniorities().length===0,'G1','Seniority levels','No levels ticked');
    need(!v('falsePos3'),'G1','False-positive exclusions','Where lead quality lives');
  } else if(otherModes){
    need(!v('personaOther'),'G1','Audience detail','Persona mode selected but nothing supplied');
    need(!v('falsePos2'),'G1','False-positive exclusions','Where lead quality lives');
  }
  if(isTAL){
    need(!ck('talUploaded'),'G1','TAL not uploaded','The account list hasn’t arrived — count cannot run');
    need(!v('talGeo'),'G1','TAL application across geographies','Global or market-specific?');
    need(!v('exclTrumps'),'G1','Exclusion trumps TAL','Client must answer explicitly — never defaulted');
  }
  need(!v('lt1'),'G2','Lead type 1','Cannot price');
  need(!v('vol'),'G2','Lead volume','Cannot price');
  need(!v('cpl'),'G2','CPL','Cannot price');
  need(!v('journey'),'G2','Lead journey after reporting','Client expectation unset');
  need(!v('kpi'),'G2','KPIs','No definition of success');
  need(!v('cplApproved'),'G3','Approved CPL','Cannot generate the IO');
  need(!v('start')||!v('end'),'G4','Campaign dates','Cannot build');
  need(!v('assets'),'G4','Assets to be used','Studio has nothing to work from');
  need(!ck('assetsUp')&&!!v('assets'),'G4','Assets not uploaded','Named but not loaded');
  need(!v('script'),'G4','Script questions','Telemarketing has nothing to work from');
  need(isBoth&&!v('split'),'G4','Lead split at campaign level','Two campaigns and no split — nobody knows which audience owes what');
  need(!v('pacing'),'G4','Lead pacing schedule','Risk of front-loading or a quarter-end scramble');
  need(!v('reporting'),'G5','Reporting day & process','No agreed client cadence');

  /* contradictions */
  const C=[];
  if(isBoth && !ck('talCampaign')) C.push(['Targeting type vs checkbox','Type is TAL + Whitespace but <b>TAL Campaign</b> is unticked.']);
  if(isBoth && !ck('wsCampaign')) C.push(['Targeting type vs checkbox','Type is TAL + Whitespace but <b>Whitespace Campaign</b> is unticked — the fallback audience may never get counted.']);
  if(isWS && !isBoth && selectedIndustries().length===0)
    C.push(['Whitespace with no industries','On Whitespace the industry picker <i>is</i> the selection criteria. With none selected there is no audience.']);
  if(v('end') && v('jobEnd') && new Date(v('end'))>new Date(v('jobEnd')))
    C.push(['Campaign runs past the Job','Campaign end date is after the Job end date.']);
  const w=weeksBetween(v('start'),v('end')), n=+v('vol');
  if(w>0 && n>0) {
    const rate=(n/w).toFixed(1);
    if(!v('pacing')) C.push(['Pacing unstated',`Set a pacing schedule — ${n} leads across ~${w} weeks means <b>${rate}/week</b>, and without a rule it front-loads or scrambles at the end.`]);
  }
  const sen=seniorities();
  if(isFS && sen.length===1 && sen[0]==='Executive/C-Level' && n>=40)
    C.push(['C-level only at volume',`Only <b>Executive/C-Level</b> ticked against a ${n}-lead target. C-suite alone rarely carries volume — consider adding Director/Head, or expect to switch to Whitespace.`]);
  if(isFS && sen.includes('Practitioner/Specialist') && /bant/i.test(v('lt1')+v('lt2')))
    C.push(['Practitioners on a BANT product','<b>Practitioner/Specialist</b> is ticked on a BANT lead type. Practitioners rarely hold budget or authority, so expect rejections on the A and B criteria.']);
  const ind0=selectedIndustries();
  if(ind0.some(x=>x.p==='Technology & IT' && (x.s[0]==='(all)'||x.s.includes('Cybersecurity'))) &&
     /cyber|security/i.test(v('progName')))
    C.push(['Cybersecurity as industry vs audience','You have selected the <b>Cybersecurity</b> sub-industry on a security-themed program. That targets security <i>vendors</i>. If you want security buyers inside other verticals, this belongs in the persona, not the industry.']);
  const totalSubs = selectedIndustries().reduce((a,x)=>a+x.n,0);
  if(totalSubs>=25) C.push(['Broad industry selection',`${totalSubs} sub-industries selected across ${selectedIndustries().length} verticals. Worth confirming the client wants this breadth — wide nets inflate the count and produce leads they later reject.`]);
  if(sizes().length && !sizes().includes('201-500') && !sizes().includes('501-1,000') && n>=100)
    C.push(['Enterprise-only at volume','Enterprise-only bands with a high lead target — check the matched universe supports it.']);

  /* paint */
  const gl=$('gapList');
  if(!G.length && !C.length){
    gl.innerHTML='<div class="allgood">Nothing blocking.<br>Ready to key in.</div>';
  } else {
    const order={G1:0,G2:1,G3:2,G4:3,G5:4};
    G.sort((a,b)=>order[a.gate]-order[b.gate]);
    const lbl={G1:'G1 · COUNT',G2:'G2 · PRICING',G3:'G3 · IO',G4:'G4 · BUILD',G5:'G5 · REPORTING'};
    gl.innerHTML =
      C.map(c=>`<div class="clash"><b>${c[0]}</b>${c[1]}</div>`).join('') +
      G.map(g=>`<div class="gp ${g.gate}"><span class="gt">${lbl[g.gate]}</span>
        <div class="gn">${g.name}</div><div class="gw">${g.why}</div></div>`).join('');
  }
  const TOTAL=28;
  $('mDone').textContent=Math.max(0,TOTAL-G.length);
  $('mTodo').textContent=G.length;
  $('mGate').textContent=G.length?G[0].gate:'clear';
  window.__G=G; window.__C=C;
}

/* ---------- output ---------- */
function buildText(){
  const L=[], add=(k,val)=>L.push(k+'\t'+(val||'[MISSING]'));
  L.push('PROGRAM BRIEF — '+(v('progName')||'(unnamed)'));
  L.push('Generated '+new Date().toLocaleDateString('en-AU'));
  L.push('');
  L.push('== TAB 1 · PROGRAM INFORMATION ==');
  add('Count Request Name',v('progName')); add('Job',v('job')); add('Vendor',v('vendor'));
  add('Currency',v('ccy')); add('Program Status',v('status'));
  add('Salesperson',v('owner')); add('Customer Success Manager',v('csm'));
  L.push(''); L.push('== TAB 2 · AUDIENCE SIZE ==');
  add('Due Date',v('countDue')); add('Campaign Targeting Type',v('tgtType'));
  add('Target Geographies',v('geo'));
  add('Industries', fmt(selectedIndustries()));
  add('Target Employee Size Range', sizes().join(';'));
  add('Other Firmographic Parameters',v('otherFirmo'));
  const tt=v('tgtType');
  if(tt.includes('TAL')){
    add('TAL Campaign',ck('talCampaign')?'Yes':'No');
    add('TAL Uploaded',ck('talUploaded')?'Yes':'No');
    add('TAL application across geographies',v('talGeo'));
    add('Exclusion trumps TAL',v('exclTrumps'));
    add('Other TAL Instructions',v('talNotes'));
  }
  if(tt.includes('Whitespace')) add('Whitespace Campaign',ck('wsCampaign')?'Yes':'No');
  add('Exclusion List Provided',ck('exclProvided')?'Yes':'No');
  add('Exclusion Instructions',v('exclNotes'));
  add('Contact-level Dedupe Provided',ck('dedupe')?'Yes':'No');
  add('Exclude IT Vendors and MSPs',ck('exclIT')?'Yes':'No');
  add('Type of Title Targeting',v('personaMode'));
  if(v('personaMode')==='Function + Seniority'){
    add('Functions', fmt(selectedFunctions()));
    add('Seniority levels', seniorities().join('; '));
  } else {
    const titles=v('titles')||v('personaOther');
    add('Explanation of Audience & Example Titles', (v('seniority')? v('seniority')+'\n\n':'')+titles);
  }
  add('Notes to Data',v('dataNotes'));
  add('False positives to exclude (for the Boolean)', v('falsePos')||v('falsePos2')||v('falsePos3'));
  L.push(''); L.push('== TAB 3 · MAX AVAILS & PRICING ==');
  add('Lead Type 1',v('lt1')); add('Lead Type 1 – Criteria',v('lt1crit'));
  add('Lead Type 1 – Max Results per Account',v('lt1max'));
  add('Lead Type 1 – CPL Request/Context',v('cpl'));
  add('Lead Type 2',v('lt2'));
  const tot=(+v('vol')&&+v('cpl'))?(+v('vol')*+v('cpl')).toLocaleString('en-AU'):'';
  add('Revenue Type: Lead Generation', (v('vol')&&v('cpl'))? `${v('vol')} leads @ ${v('cpl')} ${v('ccy')} = ${tot} ${v('ccy')}`:'');
  add('Lead Journey After Reporting',v('journey')); add('KPIs',v('kpi'));
  add('Approved CPL with Notes',v('cplApproved')); add('Max Volume Notes',v('volNotes'));
  add('Description of Program',v('desc'));
  L.push(''); L.push('== TAB 4 · CAMPAIGN SETUP ==');
  add('Campaign Name',v('progName')); add('Start Date',v('start')); add('End Date',v('end'));
  add('Campaign Order Status',v('orderStatus')); add('Reporting Day & Process',v('reporting'));
  add('Lead Split at Campaign Level',v('split')); add('Lead Pacing Schedule',v('pacing'));
  add('General Instructions',v('genInstr'));
  L.push(''); L.push('== TAB 5–6 · ASSETS & SCRIPT ==');
  add('Assets Uploaded',ck('assetsUp')?'Yes':'No');
  add('Assets to be used',v('assets')); add('Script Request Details',v('script'));
  if(window.__C?.length){
    L.push(''); L.push('== CONTRADICTIONS ==');
    window.__C.forEach(c=>L.push('! '+c[0]+' — '+c[1].replace(/<[^>]+>/g,'')));
  }
  if(window.__G?.length){
    L.push(''); L.push('== STILL BLOCKING ==');
    window.__G.forEach(g=>L.push('['+g.gate+'] '+g.name+' — '+g.why));
  }
  return L.join('\n');
}
function showOut(){ $('dlgB').textContent=buildText(); $('dlg').showModal(); }
function copyDlg(b){ navigator.clipboard.writeText($('dlgB').textContent);
  const t=b.textContent;b.textContent='Copied';setTimeout(()=>b.textContent=t,1100); }
function copyTsv(){ navigator.clipboard.writeText(buildText()); }

document.querySelectorAll('input,select,textarea').forEach(el=>{
  el.addEventListener('input',render); el.addEventListener('change',render);
});
render();
</script>
