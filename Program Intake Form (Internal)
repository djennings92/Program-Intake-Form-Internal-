<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Program Intake — Direct it</title>
<style>
:root{
  --ink:#12181f; --ink2:#4a5763; --ink3:#7b8792;
  --line:#e2e7ec; --line2:#eef2f5; --bg:#f6f8fa; --card:#fff;
  --teal:#0b7c8c; --tealdk:#075a66; --teallt:#e6f2f4;
  --g1:#b3261e; --g2:#c2610a; --g3:#9a6b00; --g4:#2f6fb5; --g5:#5d6873;
  --ok:#1b7f4f; --okbg:#e8f5ee;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
  font:15px/1.5 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
.app{display:grid;grid-template-columns:1fr 348px;gap:20px;max-width:1320px;margin:0 auto;padding:20px 20px 90px}
@media(max-width:1050px){.app{grid-template-columns:1fr}.side{position:static!important;max-height:none!important}}

/* header */
.hero{grid-column:1/-1;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:20px 24px}
.hero .eb{font-size:11.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--teal);font-weight:700}
.hero h1{margin:5px 0 4px;font-size:21px;font-weight:650;letter-spacing:-.01em}
.hero p{margin:0;font-size:13.5px;color:var(--ink2);max-width:70ch}

/* cards */
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;margin-bottom:14px;overflow:hidden}
.card>.hd{padding:13px 20px;border-bottom:1px solid var(--line);background:#fbfcfd;
  display:flex;align-items:center;gap:10px}
.card>.hd h2{margin:0;font-size:15px;font-weight:650}
.card>.hd .n{font-size:11px;font-weight:700;letter-spacing:.05em;color:var(--ink3);
  border:1px solid var(--line);border-radius:5px;padding:2px 7px;background:#fff}
.card>.bd{padding:18px 20px}

/* fields */
.row{display:grid;grid-template-columns:1fr 1fr;gap:14px 18px}
@media(max-width:640px){.row{grid-template-columns:1fr}}
.fld{display:flex;flex-direction:column;gap:5px;margin-bottom:14px}
.fld.full{grid-column:1/-1}
label{font-size:12.5px;font-weight:650;color:var(--ink2)}
label .req{color:var(--g1);margin-left:3px}
label .hint{display:block;font-weight:450;color:var(--ink3);font-size:12px;margin-top:2px;line-height:1.45}
input[type=text],input[type=date],input[type=number],select,textarea{
  width:100%;padding:8px 11px;border:1px solid var(--line);border-radius:8px;background:#fff;
  font:inherit;font-size:14px;color:var(--ink)}
textarea{min-height:76px;resize:vertical;line-height:1.5}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px var(--teallt)}
.chk{display:flex;align-items:flex-start;gap:8px;font-size:13.5px;font-weight:450;color:var(--ink);
  padding:5px 0;cursor:pointer}
.chk input{margin:2px 0 0;accent-color:var(--teal);width:15px;height:15px;flex:none}
.chkgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:2px 16px}

.cond{border-left:3px solid var(--teal);background:#fafcfd;padding:14px 16px 2px;border-radius:0 8px 8px 0;
  margin:4px 0 16px}
.cond .ct{font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--teal);
  margin-bottom:10px}
.hide{display:none!important}

/* industry tree */
.tree{border:1px solid var(--line);border-radius:9px;max-height:340px;overflow:auto;background:#fff}
.par{border-top:1px solid var(--line2)}
.par:first-child{border-top:none}
.parhd{display:flex;align-items:center;gap:9px;padding:9px 13px;cursor:pointer}
.parhd:hover{background:#fafbfc}
.parhd .tw{width:14px;color:var(--ink3);font-size:11px;flex:none;user-select:none;transition:transform .12s}
.parhd.open .tw{transform:rotate(90deg)}
.parhd input{accent-color:var(--teal);width:15px;height:15px;flex:none}
.parhd span.nm{font-weight:600;font-size:13.5px}
.parhd .cnt{margin-left:auto;font-size:11.5px;color:var(--ink3);font-weight:600}
.parhd .undoc{margin-left:auto;font-size:11px;color:var(--g3);font-weight:600;background:#fdf3e0;
  padding:2px 7px;border-radius:5px}
.kids{padding:2px 0 8px 40px;background:#fcfdfe;border-top:1px solid var(--line2)}
.kids .chk{font-size:13px;padding:3px 0}

/* side panel */
.side{position:sticky;top:20px;align-self:start;max-height:calc(100vh - 40px);overflow:auto}
.side .card{margin-bottom:12px}
.meter{display:flex;gap:6px;margin-bottom:12px}
.meter div{flex:1;text-align:center;padding:9px 4px;border-radius:8px;border:1px solid var(--line)}
.meter .big{display:block;font-size:19px;font-weight:700;line-height:1.1}
.meter .lb{font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink3);font-weight:650}
.meter .done{background:var(--okbg);border-color:#c6e4d4}.meter .done .big{color:var(--ok)}
.meter .todo{background:#fdecea;border-color:#f5c9c5}.meter .todo .big{color:var(--g1)}

.gp{border-left:3px solid var(--g5);padding:8px 0 8px 11px;margin-bottom:9px}
.gp.G1{border-color:var(--g1)}.gp.G2{border-color:var(--g2)}
.gp.G3{border-color:var(--g3)}.gp.G4{border-color:var(--g4)}
.gp .gt{font-size:10px;font-weight:700;letter-spacing:.05em;color:#fff;background:var(--g5);
  padding:1px 6px;border-radius:4px}
.gp.G1 .gt{background:var(--g1)}.gp.G2 .gt{background:var(--g2)}
.gp.G3 .gt{background:var(--g3)}.gp.G4 .gt{background:var(--g4)}
.gp .gn{font-weight:600;font-size:13.5px;margin:5px 0 2px}
.gp .gw{font-size:12.5px;color:var(--ink3);line-height:1.45}
.clash{background:#fdf3e0;border:1px solid #f0dcb4;border-radius:8px;padding:10px 12px;margin-bottom:9px;
  font-size:12.5px;line-height:1.5;color:#6b4a00}
.clash b{display:block;margin-bottom:3px;color:#4d3500}
.allgood{text-align:center;padding:22px 10px;color:var(--ok);font-size:13.5px;font-weight:600}

button{font-family:inherit;cursor:pointer}
.btn{width:100%;padding:10px;border-radius:9px;border:1px solid var(--teal);background:var(--teal);
  color:#fff;font-size:14px;font-weight:650;margin-bottom:8px}
.btn:hover{background:var(--tealdk)}
.btn.sec{background:#fff;color:var(--ink);border-color:var(--line)}
.btn.sec:hover{border-color:var(--teal);color:var(--teal)}

dialog{border:none;border-radius:12px;padding:0;max-width:840px;width:92vw;box-shadow:0 20px 60px rgba(0,0,0,.24)}
dialog::backdrop{background:rgba(15,20,26,.5)}
dialog .dh{padding:15px 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:12px}
dialog .dh h3{margin:0;font-size:16px;font-weight:650;flex:1}
dialog pre{margin:0;padding:18px 20px;max-height:62vh;overflow:auto;font:12.5px/1.6 ui-monospace,
  SFMono-Regular,Menlo,Consolas,monospace;white-space:pre-wrap;background:#fbfcfd}
dialog .df{padding:12px 20px;border-top:1px solid var(--line);display:flex;gap:8px;justify-content:flex-end}
dialog .df button{padding:8px 15px;border-radius:8px;border:1px solid var(--line);background:#fff;
  font-size:13.5px;font-weight:600}
dialog .df button.pri{background:var(--teal);border-color:var(--teal);color:#fff}
</style>
</head>
<body>
<div class="app">

  <div class="hero">
    <div class="eb">Direct it · Salesforce Program</div>
    <h1>Program intake form</h1>
    <p>Structured capture for a Count Request. Fields appear and disappear based on targeting type and persona mode,
       so you only see what actually applies. The panel on the right tracks what's still blocking each gate as you go.</p>
  </div>

  <main>
    <!-- TAB 1 -->
    <div class="card">
      <div class="hd"><span class="n">TAB 1</span><h2>Program information</h2></div>
      <div class="bd">
        <div class="row">
          <div class="fld full"><label>Program / Count Request name<span class="req">*</span>
            <span class="hint">Convention: Client FYxxQx – Theme – Tactics</span></label>
            <input type="text" id="progName" placeholder="Fujitsu FY25Q2 – Cyber with Skyhigh – Content Syndication &amp; Display"></div>
          <div class="fld"><label>Job (parent record)<span class="req">*</span></label>
            <input type="text" id="job" placeholder="Parent Job name"></div>
          <div class="fld"><label>Vendor / end client<span class="req">*</span></label>
            <input type="text" id="vendor" placeholder="Fujitsu"></div>
          <div class="fld"><label>Currency</label>
            <select id="ccy"><option>AUD</option><option>NZD</option><option>SGD</option><option>USD</option><option>EUR</option><option>GBP</option></select></div>
          <div class="fld"><label>Program status</label>
            <select id="status"><option>Scoping</option><option>Plans Discussed</option><option>Quote Provided</option>
            <option>Informal Confirmation</option><option>Conversation Started</option></select></div>
          <div class="fld"><label>Salesperson / owner<span class="req">*</span></label>
            <input type="text" id="owner" placeholder="David Jennings"></div>
          <div class="fld"><label>Customer Success Manager<span class="req">*</span></label>
            <input type="text" id="csm" placeholder="Katie Williams"></div>
        </div>
      </div>
    </div>

    <!-- TAB 2 -->
    <div class="card">
      <div class="hd"><span class="n">TAB 2</span><h2>Audience size — the count request</h2></div>
      <div class="bd">
        <div class="row">
          <div class="fld"><label>Count due date<span class="req">*</span></label><input type="date" id="countDue"></div>
          <div class="fld"><label>Target geographies<span class="req">*</span></label>
            <input type="text" id="geo" placeholder="AU only"></div>
        </div>

        <div class="fld full"><label>Campaign targeting type<span class="req">*</span>
          <span class="hint">The highest-leverage field on the record — it changes what's required below, what the count returns, and how many campaigns get built.</span></label>
          <select id="tgtType" onchange="render()">
            <option value="">— select —</option>
            <option>Targeted Account List (TAL)</option>
            <option>TAL + Whitespace</option>
            <option>Whitespace Only</option>
          </select></div>

        <!-- TAL conditional -->
        <div class="cond hide" id="talBlock">
          <div class="ct">TAL fields</div>
          <label class="chk"><input type="checkbox" id="talCampaign" onchange="render()"><span>TAL Campaign</span></label>
          <label class="chk"><input type="checkbox" id="talUploaded" onchange="render()"><span>TAL uploaded — the list has actually arrived</span></label>
          <div class="fld"><label>TAL application across geographies<span class="req">*</span>
            <span class="hint">Is the list global, or market-specific?</span></label>
            <input type="text" id="talGeo" placeholder="TAL is market-specific — only use SG accounts for the SG campaign" oninput="render()"></div>
          <div class="fld"><label>Exclusion trumps TAL?<span class="req">*</span>
            <span class="hint">If an account is on both the TAL and the exclusion list, which wins? Never default this — the client answers it.</span></label>
            <select id="exclTrumps" onchange="render()">
              <option value="">— not answered —</option>
              <option>Yes — exclusion wins</option>
              <option>No — TAL wins</option>
            </select></div>
          <div class="fld"><label>Other TAL instructions</label>
            <textarea id="talNotes"></textarea></div>
        </div>

        <!-- WS conditional -->
        <div class="cond hide" id="wsBlock">
          <div class="ct">Whitespace fields</div>
          <label class="chk"><input type="checkbox" id="wsCampaign" onchange="render()"><span>Whitespace Campaign</span></label>
        </div>

        <div class="fld full"><label>Industries<span class="req">*</span>
          <span class="hint">Select at sub-industry level. Be precise — over-selecting inflates the count and produces leads the client rejects.</span></label>
          <div class="tree" id="tree"></div></div>

        <div class="fld full"><label>Target employee size range<span class="req">*</span>
          <span class="hint">No SMB band exists — the picker starts at 201.</span></label>
          <div class="chkgrid" id="sizeGrid"></div></div>

        <div class="fld full"><label>Other firmographic parameters
          <span class="hint">Park anything that doesn't map cleanly to a sub-industry here.</span></label>
          <textarea id="otherFirmo"></textarea></div>

        <div class="fld full"><label>Exclusions &amp; dedupe</label>
          <label class="chk"><input type="checkbox" id="exclProvided" onchange="render()"><span>Exclusion list provided</span></label>
          <label class="chk"><input type="checkbox" id="dedupe"><span>Contact-level dedupe provided</span></label>
          <label class="chk"><input type="checkbox" id="exclIT"><span>Exclude IT vendors and MSPs</span></label>
        </div>
        <div class="fld full"><label>Exclusion instructions</label><textarea id="exclNotes"></textarea></div>

        <!-- personas -->
        <div class="fld full" style="margin-top:6px"><label>Type of title targeting<span class="req">*</span></label>
          <select id="personaMode" onchange="render()">
            <option value="">— select —</option>
            <option>Example title list OR general description of audience groups</option>
            <option>Function + Seniority</option>
            <option>Prebuilt Boolean</option>
            <option>Strict Title List</option>
          </select></div>

        <div class="cond hide" id="pExample">
          <div class="ct">Audience definition</div>
          <div class="fld"><label>Seniority floor<span class="req">*</span></label>
            <select id="seniority" onchange="render()">
              <option value="">— select —</option>
              <option>Manager+</option><option>Director+</option><option>VP+</option><option>C-level only</option>
            </select></div>
          <div class="fld"><label>Example titles<span class="req">*</span>
            <span class="hint">Comma-separated. Indicative, not exhaustive.</span></label>
            <textarea id="titles" oninput="render()" placeholder="Chief Information Security Officer (CISO), Head of Information Security, Director of Cyber Security…"></textarea></div>
          <div class="fld"><label>False positives to exclude<span class="req">*</span>
            <span class="hint">The quality lives here. What job titles contain your keywords but are the wrong person? For cyber: physical security, guards, fire, HSE, CCTV.</span></label>
            <textarea id="falsePos" oninput="render()" placeholder="Physical Security, Guard, Surveillance, Fire, Safety, Loss Prevention, CCTV, Patrol…"></textarea></div>
          <div class="fld"><label>Notes to data <span class="hint">Context only — no titles here.</span></label>
            <textarea id="dataNotes"></textarea></div>
        </div>

        <div class="cond hide" id="pFunc">
          <div class="ct">Function + seniority</div>
          <div class="fld"><label>Functions<span class="req">*</span>
            <span class="hint">13 parents, 22 sub-functions. Eight parents have no children — tick those directly.</span></label>
            <div class="tree" id="ftree"></div></div>
          <div class="fld"><label>Seniority levels<span class="req">*</span>
            <span class="hint">Multi-select, not a floor. Business Partner/Advisor sits outside the hierarchy.</span></label>
            <div class="chkgrid" id="senGrid"></div></div>
          <div class="fld"><label>False positives to exclude<span class="req">*</span>
            <span class="hint">Titles that match the function but are the wrong person.</span></label>
            <textarea id="falsePos3" oninput="render()"></textarea></div>
        </div>

        <div class="cond hide" id="pOther">
          <div class="ct">Audience definition</div>
          <div class="fld"><label>Audience detail<span class="req">*</span>
            <span class="hint" id="pOtherHint"></span></label>
            <textarea id="personaOther" oninput="render()"></textarea></div>
          <div class="fld"><label>False positives to exclude<span class="req">*</span></label>
            <textarea id="falsePos2" oninput="render()"></textarea></div>
        </div>
      </div>
    </div>

    <!-- TAB 3 -->
    <div class="card">
      <div class="hd"><span class="n">TAB 3</span><h2>Max avails &amp; pricing</h2></div>
      <div class="bd">
        <div class="row">
          <div class="fld"><label>Lead type 1<span class="req">*</span></label>
            <input type="text" id="lt1" placeholder="CS + Profiled" oninput="render()"></div>
          <div class="fld"><label>Lead type 1 — criteria</label><input type="text" id="lt1crit" placeholder="Profiled CS"></div>
          <div class="fld"><label>Lead volume<span class="req">*</span></label>
            <input type="number" id="vol" placeholder="48" oninput="render()"></div>
          <div class="fld"><label>Max results per account</label><input type="number" id="lt1max" placeholder="2"></div>
          <div class="fld"><label>CPL requested<span class="req">*</span></label>
            <input type="number" id="cpl" placeholder="105" oninput="render()"></div>
          <div class="fld"><label>Lead type 2 <span class="hint">Only if a second type is sold</span></label>
            <input type="text" id="lt2"></div>
          <div class="fld"><label>Lead journey after reporting<span class="req">*</span></label>
            <input type="text" id="journey" placeholder="LDR Follow Up" oninput="render()"></div>
          <div class="fld"><label>What does success look like? (KPIs)<span class="req">*</span></label>
            <input type="text" id="kpi" placeholder="Convert to SS1" oninput="render()"></div>
          <div class="fld full"><label>Approved CPL with notes</label>
            <textarea id="cplApproved" oninput="render()" placeholder="CPL is fine (usual Fujitsu rules)"></textarea></div>
          <div class="fld full"><label>Max volume notes
            <span class="hint">The deliverability view, including fallback intent.</span></label>
            <textarea id="volNotes" placeholder="Should get to 48 on TAL only, but set up Whitespace in case we need to switch"></textarea></div>
          <div class="fld full"><label>Description of program</label><textarea id="desc"></textarea></div>
        </div>
      </div>
    </div>

    <!-- TAB 4 -->
    <div class="card">
      <div class="hd"><span class="n">TAB 4</span><h2>Campaign setup details</h2></div>
      <div class="bd">
        <div class="row">
          <div class="fld"><label>Start date<span class="req">*</span></label><input type="date" id="start" onchange="render()"></div>
          <div class="fld"><label>End date<span class="req">*</span></label><input type="date" id="end" onchange="render()"></div>
          <div class="fld"><label>Job end date <span class="hint">Campaign must finish within it</span></label>
            <input type="date" id="jobEnd" onchange="render()"></div>
          <div class="fld"><label>Campaign order status</label>
            <input type="text" id="orderStatus" placeholder="Script Request / Data Request / MC Journey Request"></div>
          <div class="fld full"><label>Reporting day &amp; process<span class="req">*</span></label>
            <input type="text" id="reporting" placeholder="Weekly, Thursdays, via shared tracker" oninput="render()"></div>
          <div class="fld full"><label>Lead split at campaign level<span class="req" id="splitReq" style="display:none">*</span>
            <span class="hint" id="splitHint">Required when running TAL + Whitespace — two campaigns and no split means nobody knows which audience owes what.</span></label>
            <input type="text" id="split" placeholder="TAL 36 / Whitespace 12" oninput="render()"></div>
          <div class="fld full"><label>Lead pacing schedule<span class="req">*</span></label>
            <input type="text" id="pacing" placeholder="~7/week across 7 weeks" oninput="render()"></div>
          <div class="fld full"><label>General instructions</label><textarea id="genInstr"></textarea></div>
        </div>
      </div>
    </div>

    <!-- TAB 5 + 6 -->
    <div class="card">
      <div class="hd"><span class="n">TAB 5–6</span><h2>Assets &amp; script</h2></div>
      <div class="bd">
        <label class="chk"><input type="checkbox" id="assetsUp" onchange="render()"><span>Assets uploaded</span></label>
        <div class="fld full"><label>Assets to be used<span class="req">*</span>
          <span class="hint">One per line, each tagged with its brand.</span></label>
          <textarea id="assets" oninput="render()" placeholder="Skyhigh - Enterprise ChatGPT solution_Fujitsu&#10;Fujitsu Cyber - Cloud Assessment Brochure_Skyhigh"></textarea></div>
        <div class="fld full"><label>Script — qualifying questions<span class="req">*</span>
          <span class="hint">Standard shape: current priority → how they manage it today → where they are in the buying cycle.</span></label>
          <textarea id="script" oninput="render()" style="min-height:120px" placeholder="1. What's your main security priority right now?&#10;- Protecting sensitive data&#10;- Governing AI and Copilot use…"></textarea></div>
      </div>
    </div>
  </main>

  <!-- SIDE -->
  <aside class="side">
    <div class="card">
      <div class="hd"><h2>Readiness</h2></div>
      <div class="bd">
        <div class="meter">
          <div class="done"><span class="big" id="mDone">0</span><span class="lb">Done</span></div>
          <div class="todo"><span class="big" id="mTodo">0</span><span class="lb">Blocking</span></div>
          <div><span class="big" id="mGate" style="font-size:15px;padding-top:3px">—</span><span class="lb">Next gate</span></div>
        </div>
        <button class="btn" onclick="showOut()">Generate brief</button>
        <button class="btn sec" onclick="copyTsv()">Copy as tab-separated</button>
        <button class="btn sec" onclick="window.print()">Print / PDF</button>
      </div>
    </div>

    <div class="card">
      <div class="hd"><h2>Still blocking</h2></div>
      <div class="bd" id="gapList"></div>
    </div>
  </aside>
</div>

<dialog id="dlg">
  <div class="dh"><h3 id="dlgT">Program brief</h3></div>
  <pre id="dlgB"></pre>
  <div class="df">
    <button onclick="document.getElementById('dlg').close()">Close</button>
    <button class="pri" onclick="copyDlg(this)">Copy</button>
  </div>
</dialog>

<script>
/* ---------- taxonomy ---------- */
const INDUSTRIES = [
  {n:"Technology & IT", subs:["Software Development","Hardware & Networking","IT Services & Consulting","Telecommunications","Internet & Web Services","Cybersecurity","Cloud Computing","Artificial Intelligence & Machine Learning","Semiconductors","Data Analytics & Big Data","Computer Games","Embedded Systems & IoT"]},
  {n:"Financial Services", subs:["Banking","Insurance","Investment Management","Venture Capital & Private Equity","Accounting & Tax","Financial Planning & Advisory","Capital Markets","Payments & FinTech","Lending & Mortgages","Wealth Management"]},
  {n:"Healthcare", subs:["Hospitals & Health Systems","Pharmaceuticals","Biotechnology","Medical Devices & Equipment","Health Insurance","Mental Health & Wellness","Ambulatory Care & Home Health","Clinical Research & Trials","Veterinary Services","Public Health"]},
  {n:"Manufacturing", subs:["Automotive Manufacturing","Aerospace & Defense Manufacturing","Electronics Manufacturing","Industrial Machinery & Equipment","Chemical Manufacturing","Plastics & Packaging","Textiles & Apparel Manufacturing","Food & Beverage Manufacturing","Metal & Steel Manufacturing","Glass, Ceramics & Concrete"]},
  {n:"Retail & Consumer", subs:["Retail - General","E-Commerce","Consumer Goods","Food & Beverage Retail","Luxury Goods & Jewelry","Sporting Goods & Outdoor","Fashion & Apparel Retail","Consumer Electronics Retail","Home Improvement & Furnishings","Personal Care & Beauty"]},
  {n:"Media & Entertainment", subs:["Broadcasting & Streaming","Publishing & Journalism","Film & Television Production","Music & Recording","Gaming & Interactive Media","Advertising & Marketing","Public Relations","Graphic Design & Visual Arts","Photography","Events & Live Entertainment"]},
  {n:"Education", subs:["Higher Education","K-12 Education","E-Learning & EdTech","Vocational & Technical Training","Corporate Training & Development","Education Administration","Libraries & Archives","Research & Think Tanks"]},
